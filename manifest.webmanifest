{
  "name": "BeamBoard · presentazioni LaTeX guidate",
  "short_name": "BeamBoard",
  "lang": "it",
  "description": "Crea presentazioni Beamer con una procedura guidata, senza conoscere LaTeX.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#FBF6EC",
  "theme_color": "#2B2240",
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/json": [
          ".beamboard"
        ]
      }
    }
  ],
  "icons": [
    {
      "src": "img/icona-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "img/icona-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "img/icona-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "img/icona.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}